# Required for the Claude ops panel (POST /ops/chat)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the SSH key used for remote server connections
# EMIT_SSH_KEY_PATH=/home/user/.ssh/emit-deploy

# Optional: override the API listen port (default: 7001)
# PORT=7001

# Email alert channel (develemail). Provision with:
#   devel init --project emit-infra --env-file apps/api/.env --key-name alerts --env production
# DEVELEMAIL_BASE_URL=https://mail.develemail.com
# DEVELEMAIL_API_KEY=dk_...
# ALERT_EMAIL_FROM=alerts@develemit.com  # develemit.com is a develemail-verified domain
# ALERT_EMAIL_TO=emitdutcher@gmail.com

# Optional: origin used to turn relative alert urls into links in emails (default http://localhost:7013)
# DASHBOARD_ORIGIN=http://localhost:7013
