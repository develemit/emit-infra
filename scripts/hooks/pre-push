#!/usr/bin/env bash
# Shared pre-push hook for emit projects.
# 1. Runs CI (ci.prePush targets via nx affected)
# 2. On push to main: builds Docker images, pushes to GHCR, deploys via emit-infra
# Reads all config from .emit-infra.json.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

EMIT_INFRA_DIR="${EMIT_INFRA_DIR:-$HOME/projects/emit-infra}"
CONFIG_FILE="$ROOT/.emit-infra.json"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "pre-push: no .emit-infra.json found, skipping"
  exit 0
fi

source "$EMIT_INFRA_DIR/scripts/lib/ci-utils.sh"
source "$EMIT_INFRA_DIR/scripts/lib/deploy-plan.sh"
source "$EMIT_INFRA_DIR/scripts/lib/docker-build.sh"
source "$EMIT_INFRA_DIR/scripts/lib/image-arch-check.sh"
source "$EMIT_INFRA_DIR/scripts/lib/pre-push-config.sh"
source "$EMIT_INFRA_DIR/scripts/lib/pre-push-ci-phase.sh"

# ── read config ────────────────────────────────────────────────────────────────
load_pre_push_config "$CONFIG_FILE"

SSH_KEY="${SSH_KEY/#\~/$HOME}"
SHA=$(git rev-parse HEAD)
# Exported here, not at deploy time: the image build below shells out to
# python3 (docker-build.sh's get_build_args) to resolve .emit-infra.json's
# buildArgs from the environment, and a plain shell variable is invisible to a
# subprocess. Exporting only before `emit-infra deploy` — which is where this
# used to live — is far too late for the build that bakes the value in.
export SHA
BUILD_NUMBER=$(git rev-list --count HEAD)
export BUILD_NUMBER

# ── phase 1: CI ────────────────────────────────────────────────────────────────
run_ci

# ── phase 2: deploy (only on push to main) ────────────────────────────────────
PUSHING_TO_MAIN=false
LOCAL_SHA=""
REMOTE_SHA=""
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    PUSHING_TO_MAIN=true
    LOCAL_SHA="$_local_sha"
    REMOTE_SHA="$_remote_sha"
    break
  fi
done

if [[ "$PUSHING_TO_MAIN" != "true" ]]; then
  exit 0
fi

if [[ -z "$GHCR_ORG" ]]; then
  echo "pre-push: ci.ghcrOrg not set in .emit-infra.json, skipping deploy"
  exit 0
fi

# ── dry-run guard ─────────────────────────────────────────────────────────────
# `git push --dry-run` runs pre-push hooks with no way to tell it apart, so a
# dry run used to build and deploy for real. Detect it from the invoking git
# process's argv instead. CI has already run at this point, which is all a dry
# run should ever do.
if [[ "${EMIT_FORCE_DEPLOY:-0}" != "1" ]] && detect_dry_run_push; then
  echo "→ git push --dry-run detected; CI ran, skipping deploy (EMIT_FORCE_DEPLOY=1 to override)"
  exit 0
fi

# Optional belt-and-braces prompt for anyone who wants one; off by default so a
# normal push stays non-interactive.
if [[ "${EMIT_DEPLOY_CONFIRM:-0}" == "1" && -e /dev/tty ]]; then
  read -r -p "Deploy $PROJECT_NAME to production? [y/N] " _reply < /dev/tty || _reply=""
  if [[ ! "$_reply" =~ ^[Yy] ]]; then
    echo "→ deploy declined; push continues"
    exit 0
  fi
fi

# ── last deployed sha (used by path filter + smart build) ─────────────────────
LAST_SHA=$(resolve_last_deployed_sha "$ROOT")

# ── path filter: skip deploy when only ignored paths changed ──────────────────
# Ignore-list semantics: deploy is skipped only if EVERY file changed since the
# last deploy matches an ignore pattern. Unknown paths always deploy (safe
# default). Override with EMIT_FORCE_DEPLOY=1 (e.g. after env-only changes,
# which are gitignored and invisible to this diff). The skip message names
# what was ignored and states plainly that nothing will ship — a stuck
# 34-commit backlog went unnoticed for days reading as routine (sprint 292).
if [[ "${EMIT_FORCE_DEPLOY:-0}" != "1" ]] && \
   only_ignored_paths_changed "$LAST_SHA" "${DEPLOY_IGNORE_PATHS[@]}"; then
  echo "⚠ deploy SKIPPED: every file changed since ${LAST_SHA:0:7} matches an ignored pattern (${DEPLOY_IGNORE_PATHS[*]}) — no deploy will run for ${SHA:0:7} (EMIT_FORCE_DEPLOY=1 to override)"
  exit 0
fi

echo "→ pushing to main — running deploy"
push_payload_summary "$REMOTE_SHA" "$LOCAL_SHA"

# ── unattended-shell gate ─────────────────────────────────────────────────────
# Must land here: after every gate that exits 0 (dry-run, ignored-paths), and
# before _fail_deploy/deploy_init below — exiting non-zero after deploy_init
# runs would fire the ERR trap with _EMIT_STARTED_EPOCH unset, writing a status
# record this gate promises not to write. See docs/DEPLOY-GATES.md#unattended-shell-gate.
# EMIT_DEPLOY_DETACHED=1 is a declaration the caller makes, not something this
# gate can verify (see deploy_launch_mode in deploy-launch.sh). The deprecated
# EMIT_ALLOW_UNATTENDED_DEPLOY alias still works so the fleet doesn't break
# mid-transition.
if [[ "${EMIT_DEPLOY_DETACHED:-0}" != "1" && "${EMIT_ALLOW_UNATTENDED_DEPLOY:-0}" != "1" ]]; then
  if MARKER=$(detect_unattended_shell); then
    echo "✗ pre-push: refusing to deploy $PROJECT_NAME from a teardown-prone shell (\$$MARKER set)" >&2
    echo "  A killed shell leaves a deploy half-finished — see docs/DEPLOY-GATES.md#unattended-shell-gate." >&2
    echo "  Use the detached deploy path instead: scripts/deploy-detached.sh (or the /deploy skill)." >&2
    echo "  Certain this shell will survive? Override with: EMIT_DEPLOY_DETACHED=1 git push" >&2
    exit 1
  elif ! has_controlling_terminal; then
    echo "⚠ pre-push: no controlling terminal and no unattended-shell marker set; proceeding" >&2
  fi
else
  deploy_warn_deprecated_override
fi
read -r LAUNCH_MODE LAUNCH_MARKER <<< "$(deploy_launch_mode)"

# source env file for deploy phase (after CI so tests use local env)
if [[ -n "$ENV_FILE" && -f "$ROOT/$ENV_FILE" ]]; then
  set -a; source "$ROOT/$ENV_FILE"; set +a
fi

_fail_deploy() {
  deploy_done failed
  echo "✗ deploy failed"
  exit 1
}
trap _fail_deploy ERR

# ── smart build: only rebuild services affected since last deploy ─────────────
# Prefer the real Nx dependency graph over a `packages/` glob so a change to one
# package doesn't rebuild every service. Non-Nx repos (and services whose name
# isn't an Nx project) fall back to the original glob behavior.
# If either nx query fails, NX_ALL_PROJECTS is cleared so every service falls
# back to the glob — an empty affected list must never be mistaken for "nx ran
# and found nothing".
NX_ALL_PROJECTS=""
NX_AFFECTED_PROJECTS=""
if [[ -n "$LAST_SHA" ]] && git rev-parse --quiet --verify "$LAST_SHA" >/dev/null && nx_available; then
  if NX_ALL_PROJECTS=$(nx_projects) &&
     NX_AFFECTED_PROJECTS=$(nx_projects --affected --base="$LAST_SHA" --head=HEAD); then
    echo "→ nx affected since ${LAST_SHA:0:7}: ${NX_AFFECTED_PROJECTS//$'\n'/ }"
  else
    echo "→ nx graph query failed; falling back to path-glob rebuild detection"
    NX_ALL_PROJECTS=""
    NX_AFFECTED_PROJECTS=""
  fi
fi

IFS=' ' read -r -a ALL_SVCS <<< "$BG_SERVICES"
TO_BUILD=()
TO_RETAG=()
# ${arr[@]+"${arr[@]}"} — bash 3.2 errors on "${arr[@]}" for an EMPTY array
# under `set -u` (line 6). Reachable for any project whose .emit-infra.json
# omits blueGreen.services or sets it to []. Same idiom as TO_BUILD below.
for svc in ${ALL_SVCS[@]+"${ALL_SVCS[@]}"}; do
  if service_needs_build "$svc" "$LAST_SHA" "$NX_ALL_PROJECTS" "$NX_AFFECTED_PROJECTS" "$BUILD_TRIGGER_PATHS"; then
    TO_BUILD+=("$svc")
  else
    TO_RETAG+=("$svc")
  fi
done

deploy_set_services ${TO_BUILD[@]+"${TO_BUILD[@]}"}

if [[ ${#TO_BUILD[@]} -gt 0 ]]; then
  echo "→ services to build: ${TO_BUILD[*]}"
  [[ ${#TO_RETAG[@]} -gt 0 ]] && echo "→ services unchanged (re-tag only): ${TO_RETAG[*]}"
else
  echo "→ all services unchanged since last deploy, re-tagging only"
fi

# steps: auth + (build+push + arch-check if needed) + (retag if needed) + deploy
STEPS=2
[[ ${#TO_BUILD[@]} -gt 0 ]] && STEPS=$((STEPS + 2))
[[ ${#TO_RETAG[@]} -gt 0 ]] && STEPS=$((STEPS + 1))

# count pre-deploy commands
PRE_DEPLOY_COUNT=$(python3 -c "import json; print(len(json.loads('$PRE_DEPLOY_JSON')))" 2>/dev/null || echo 0)
STEPS=$((STEPS + PRE_DEPLOY_COUNT))

deploy_init "$STEPS" "$LAUNCH_MODE" "$LAUNCH_MARKER"
_emit_trap_signals deploy
deploy_record_phase ci "$_EMIT_CI_DURATION"

# ── GHCR auth (isolated config to avoid docker-credential-desktop hangs) ──────
deploy_phase auth
deploy_step "GHCR auth"
TOKEN="${GHCR_TOKEN:-$(gh auth token 2>/dev/null || true)}"
if [[ -z "$TOKEN" ]]; then
  echo "error: set GHCR_TOKEN or run 'gh auth login'" >&2; exit 1
fi
DOCKER_CI_CONFIG="${TMPDIR:-/tmp}/emit-docker-ci"
mkdir -p "$DOCKER_CI_CONFIG"
if [[ -d "$HOME/.docker/cli-plugins" && ! -e "$DOCKER_CI_CONFIG/cli-plugins" ]]; then
  ln -s "$HOME/.docker/cli-plugins" "$DOCKER_CI_CONFIG/cli-plugins"
fi
echo "$TOKEN" | docker --config "$DOCKER_CI_CONFIG" login ghcr.io -u "${GHCR_USER:-$GHCR_ORG}" --password-stdin
export DOCKER_CONFIG="$DOCKER_CI_CONFIG"

if [[ ${#TO_BUILD[@]} -gt 0 ]]; then
  deploy_phase build
  deploy_step "Building + pushing images"
  # Two concurrent emulated linux/amd64 Node builds can exhaust the Docker
  # build VM's memory, so a plain push must default to sequential. Raise via
  # EMIT_BUILD_PARALLEL on a host with more Docker build memory configured.
  MAX_PARALLEL=${EMIT_BUILD_PARALLEL:-1}
  run_build_fanout "$MAX_PARALLEL" _fail_deploy "${TO_BUILD[@]}"

  deploy_phase archCheck
  deploy_step "Checking image architecture"
  run_image_arch_checks "${TO_BUILD[@]}" || _fail_deploy
fi

if [[ ${#TO_RETAG[@]} -gt 0 ]]; then
  deploy_phase retag
  deploy_step "Re-tagging unchanged images"
  for svc in "${TO_RETAG[@]}"; do retag_image "$svc"; done
fi

# ── pre-deploy commands (migrations etc.) ──────────────────────────────────────
if [[ "$PRE_DEPLOY_COUNT" -gt 0 ]]; then
  deploy_phase preDeploy
  python3 -c "
import json
cmds = json.loads('$PRE_DEPLOY_JSON')
for cmd in cmds:
    print(cmd)
" | while IFS= read -r cmd; do
    deploy_step "Pre-deploy: $cmd"
    echo "→ $cmd"
    eval "$cmd"
  done
fi

# ── deploy via emit-infra ─────────────────────────────────────────────────────
deploy_phase deploy
deploy_step "Deploying via emit-infra"
echo "→ running emit-infra deploy"
export GHCR_TOKEN="$TOKEN"
export GHCR_ACTOR="${GHCR_USER:-$GHCR_ORG}"
node "$EMIT_INFRA_DIR/apps/cli/dist/index.js" deploy

deploy_done deployed
_emit_untrap_signals
echo "✓ deployed $SHA (build $BUILD_NUMBER)"
