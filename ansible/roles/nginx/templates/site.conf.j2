{% if nginx_ssl | default(true) %}
# HTTP to HTTPS redirect with ACME challenge passthrough
server {
    listen 80;
    server_name {{ domain }} www.{{ domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server block
server {
    listen 443 ssl;
    server_name {{ domain }} www.{{ domain }};

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;

{% if nginx_api_path_prefix is defined and nginx_api_upstream is defined %}
    # API path prefix routed directly to the upstream at the proxy layer.
    # proxy_pass has NO trailing slash / URI component: with one, nginx strips
    # the matched prefix before forwarding and every API call breaks. This
    # block must precede location / or requests fall through to the web
    # upstream and never reach the API.
    location {{ nginx_api_path_prefix }} {
        proxy_pass http://{{ nginx_api_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endif %}
    location / {
        proxy_pass http://127.0.0.1:{{ app_port | default(3000) }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
{% else %}
# Plain HTTP fallback (for local/test environments)
server {
    listen 80;
    server_name {{ domain }} www.{{ domain }};

{% if nginx_api_path_prefix is defined and nginx_api_upstream is defined %}
    # API path prefix routed directly to the upstream at the proxy layer.
    # proxy_pass has NO trailing slash / URI component: with one, nginx strips
    # the matched prefix before forwarding and every API call breaks. This
    # block must precede location / or requests fall through to the web
    # upstream and never reach the API.
    location {{ nginx_api_path_prefix }} {
        proxy_pass http://{{ nginx_api_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endif %}
    location / {
        proxy_pass http://127.0.0.1:{{ app_port | default(3000) }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
{% endif %}
