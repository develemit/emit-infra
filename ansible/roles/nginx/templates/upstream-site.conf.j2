{% if blue_green | default(false) %}
# Active upstreams are defined by the slot include file written by blue-green-deploy.sh.
include /etc/nginx/blue-green/{{ project_name }}.conf;
{% else %}
upstream {{ project_name }}_backend {
    server 127.0.0.1:{{ active_backend_port | default(app_port | default(3000)) }};
}
{% endif %}

{% if nginx_ssl | default(true) %}
# HTTP to HTTPS redirect with ACME challenge passthrough
server {
    listen 80;
    server_name {{ domain }}{% if nginx_www | default(true) %} www.{{ domain }}{% endif %};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server block
server {
    listen 443 ssl;
    server_name {{ domain }}{% if nginx_www | default(true) %} www.{{ domain }}{% endif %};

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;

    location / {
        proxy_pass http://{{ project_name }}_{% if blue_green | default(false) %}web{% else %}backend{% endif %};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
{% else %}
# Plain HTTP fallback (for local/test environments)
server {
    listen 80;
    server_name {{ domain }}{% if nginx_www | default(true) %} www.{{ domain }}{% endif %};

    location / {
        proxy_pass http://{{ project_name }}_{% if blue_green | default(false) %}web{% else %}backend{% endif %};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
{% endif %}

{% if nginx_api_port is defined or blue_green | default(false) %}
{% if nginx_ssl | default(true) %}
# HTTP to HTTPS redirect for API subdomain
server {
    listen 80;
    server_name api.{{ domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server block for API subdomain
server {
    listen 443 ssl;
    server_name api.{{ domain }};

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;

    location / {
        proxy_pass http://{{ project_name }}_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
{% else %}
# Plain HTTP fallback for API subdomain
server {
    listen 80;
    server_name api.{{ domain }};

    location / {
        proxy_pass http://{{ project_name }}_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
{% endif %}
{% endif %}
